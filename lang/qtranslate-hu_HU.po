msgstr "Nem sikerült „%s” fájl betöltése, megadva ebben az opcióban: „%s”."

msgid "Could not parse %s file \"%s\" listed in option \"%s\"."
msgstr "Nem sikerült %s fájl értelmezése „%s” megadva ebben az opcióban: „%s”."

msgid "Could not write to \"%s\", Gettext Databases could not be downloaded!"
msgstr "Nem sikerült írni \"%s\", a Gettext adatbázisokat nem sikerült letölteni!"

