msgstr "Fájl neve"

msgid "File size"
msgstr "Fájl mérete"

msgid "Fill empty multilingual fields with content from other language"
msgstr "Üres többnyelvű mezők tartalmának kitöltése egy másik nyelvből másolva"

msgid "Filter all WordPress options for translation at front-end. It may hurt performance of the site, but ensures that all options are translated."
msgstr "Minden WordPress opciót szűrőn át jelenít meg a front-enden. Rontja a weboldal teljesítményét, de így minden opció biztosan le lesz fordítva."

msgid "Flag"
msgstr "Zászló"

msgid "Flag Image HTML"
msgstr "Zászló kép HTML"

msgid "Flag Image Path"
msgstr "Zászló képek elérési útja"

