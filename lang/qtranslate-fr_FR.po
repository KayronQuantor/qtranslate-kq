msgid "Could not find file \"%s\" listed in option \"%s\"."
msgstr "Le fichier \"%s\" listé dans l’option \"%s\" est introuvable."

msgid "Could not find script file \"%s\" for handle \"%s\"."
msgstr "Le fichier de script \"%s\" pour le handle \"%s\" est introuvable."

msgid "Could not load file \"%s\" listed in option \"%s\"."
msgstr "Le fichier \"%s\" listé dans l’option \"%s\" n’a pas pu être chargé."

msgid "Could not parse %s file \"%s\" listed in option \"%s\"."
msgstr "%s fichiers \"%s\" listés dans l’option \"%s\" n’ont pas pu être analysés."

